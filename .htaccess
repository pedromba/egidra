# ════════════════════════════════════════════════════════════════════
#  EGIDRA — Raíz  ·  /.htaccess
# ════════════════════════════════════════════════════════════════════

# ── Deshabilitar listado de directorios ──────────────────────────────
Options -Indexes -MultiViews

# ── Bloquear acceso directo a /include/ ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)include/ - [F,L]

    # ── Dominio canónico: www.egidra.com → egidra.com ──
    RewriteCond %{HTTP_HOST} ^www\.egidra\.com$ [NC]
    RewriteRule ^(.*)$ https://egidra.com/$1 [R=301,L]

    # ── Sitemap dinámico ──
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ── Bloquear archivos sensibles ───────────────────────────────────────
<FilesMatch "(\.htaccess|\.htpasswd|\.env|\.git|\.log|\.sql|\.bak|\.sh|CLAUDE\.md|DEPLOY\.md)$">
    Require all denied
</FilesMatch>

# ── Cabeceras de seguridad ────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
