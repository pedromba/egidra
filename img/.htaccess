# ════════════════════════════════════════════════════════════════════
#  EGIDRA — Imágenes subidas  ·  /img/.htaccess
# ════════════════════════════════════════════════════════════════════

# ── Nunca ejecutar scripts en carpetas de subida ─────────────────────
<FilesMatch "\.(php\d?|phtml|phar|pht|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
